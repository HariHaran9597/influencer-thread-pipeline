# Copy to .env and fill in what you have. Every key is optional:
# missing keys drop the pipeline into deterministic mock mode (full demo works offline).

# Writer/editor LLM (free tier: ~30 req/min, ~14,400 req/day) — https://console.groq.com
GROQ_API_KEY=

# Web research (free tier: 1,000 credits/month) — https://tavily.com
TAVILY_API_KEY=

# Independent fact-check/style judge (recommended: judge != writer model) — https://aistudio.google.com
GOOGLE_API_KEY=

# Tracing (optional, free dev tier) — https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=

# Model overrides (defaults below; check https://console.groq.com/docs/models for current IDs)
WRITER_MODEL=llama-3.3-70b-versatile
JUDGE_MODEL=llama-3.1-8b-instant

# Force offline mock mode even if keys are present (1/0)
MOCK_LLM=0

# Deployment hardening (optional locally; recommended for a public API)
API_AUTH_TOKEN=
CORS_ORIGINS=http://localhost:8000
RATE_LIMIT_PER_MINUTE=30

# 0 keeps PII-redacted/minimized content in persistent traces; use 1 only for
# local debugging where raw source/draft retention is acceptable.
TRACE_RAW_CONTENT=0
